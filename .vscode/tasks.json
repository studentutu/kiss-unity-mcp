{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Unity MCP: Check tool paths",
      "type": "process",
      "command": "git",
      "args": [
        "-c",
        "alias.unity-bash=!bash",
        "unity-bash",
        "${workspaceFolder}/scripts/unity.sh",
        "doctor",
        "${input:unityProject}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Unity MCP: Import and generate solution",
      "type": "process",
      "command": "git",
      "args": [
        "-c",
        "alias.unity-bash=!bash",
        "unity-bash",
        "${workspaceFolder}/scripts/unity.sh",
        "import",
        "${input:unityProject}"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Unity MCP: Fast MSBuild",
      "type": "process",
      "command": "git",
      "args": [
        "-c",
        "alias.unity-bash=!bash",
        "unity-bash",
        "${workspaceFolder}/scripts/unity.sh",
        "build",
        "${input:unityProject}"
      ],
      "group": "build",
      "problemMatcher": "$msCompile"
    },
    {
      "label": "Unity MCP: EditMode tests",
      "type": "process",
      "command": "git",
      "args": [
        "-c",
        "alias.unity-bash=!bash",
        "unity-bash",
        "${workspaceFolder}/scripts/unity.sh",
        "tests",
        "${input:unityProject}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Unity MCP: Parse test results",
      "type": "process",
      "command": "git",
      "args": [
        "-c",
        "alias.unity-bash=!bash",
        "unity-bash",
        "${workspaceFolder}/scripts/unity.sh",
        "parse-tests",
        "${input:unityProject}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Unity MCP: Compile shaders",
      "type": "process",
      "command": "git",
      "args": [
        "-c",
        "alias.unity-bash=!bash",
        "unity-bash",
        "${workspaceFolder}/scripts/unity.sh",
        "shaders",
        "${input:unityProject}"
      ],
      "group": "build",
      "problemMatcher": []
    },
    {
      "label": "Unity MCP: Open tool settings",
      "type": "process",
      "command": "code",
      "args": [
        "--reuse-window",
        "${input:unityProject}/.unity-simple-mcp/tools.env"
      ],
      "group": "build",
      "problemMatcher": []
    }
  ],
  "inputs": [
    {
      "description": "Absolute Unity project path",
      "type": "promptString",
      "id": "unityProject"
    }
  ]
}
